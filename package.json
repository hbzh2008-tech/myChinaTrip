{
  "name": "chinatrip",
  "private": true,
  "version": "0.1.0",
  "description": "China travel planning — full-stack monorepo with OpenSpec harness",
  "scripts": {
    "dev": "pnpm --filter @chinatrip/web run dev",
    "dev:api": "cd backend && gradlew.bat bootRun",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:api": "cd backend && gradlew.bat test",
    "lint": "pnpm -r run lint"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
